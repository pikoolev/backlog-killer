# Native Ubuntu 24.04 deployment. Never commit the populated .env file.
VPS_IP=
VPS_USER=root
VPS_PASSWORD=
VPS_SSH_PORT=22
VPS_TRUSTED_IP_CIDR=

# Hostnames only; do not include https:// or paths.
APP_DOMAIN=example.com
SDK_PUBLIC_HOST=sdk.example.com
PANEL_PUBLIC_HOST=panel.example.com
API_PUBLIC_HOST=api.example.com
OIDC_PUBLIC_HOST=auth.example.com
ACME_EMAIL=admin@example.com

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

APP_ENV=production
DEPLOYMENT_MODE=saas
POSTGRES_DB=backlog_killer
POSTGRES_MIGRATION_USER=backlog_migrator
OIDC_REALM=backlog-killer
OIDC_AUDIENCE=backlog-killer-api
OIDC_CLIENT_ID=backlog-killer-web
STORAGE_PROJECT_QUOTA_BYTES=1073741824
