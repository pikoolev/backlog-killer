# Local domains. Replace only these public URLs/hosts when moving to a VPS.
APP_ENV=development
DEPLOYMENT_MODE=saas
LOCAL_DEMO_SEED=true
API_PUBLIC_URL=http://api.localhost:18080
WEB_PUBLIC_URL=http://backlog.localhost:4173
OIDC_PUBLIC_URL=http://identity.localhost:8081
CLIENT_PUBLIC_URL=http://client.localhost:4174
API_PUBLIC_HOST=api.example.com
WEB_PUBLIC_HOST=backlog.example.com
OIDC_PUBLIC_HOST=identity.example.com

POSTGRES_DB=backlog_killer
POSTGRES_USER=backlog_runtime
POSTGRES_PASSWORD=change-me-runtime
POSTGRES_MIGRATION_USER=backlog_migrator
POSTGRES_MIGRATION_PASSWORD=change-me-migrator
DATABASE_URL=postgres://backlog_runtime:change-me-runtime@postgres:5432/backlog_killer?sslmode=disable
MIGRATION_DATABASE_URL=postgres://backlog_migrator:change-me-migrator@postgres:5432/backlog_killer?sslmode=disable

OIDC_ISSUER=http://keycloak:8080/realms/backlog-killer
OIDC_PUBLIC_ISSUER=http://identity.localhost:8081/realms/backlog-killer
OIDC_REALM=backlog-killer
OIDC_AUDIENCE=backlog-killer-api
OIDC_CLIENT_ID=backlog-killer-web
OIDC_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_DB_PASSWORD=change-me-keycloak-database

EMBED_SIGNING_KEY=replace-with-at-least-32-random-bytes
STORAGE_DRIVER=filesystem
STORAGE_PATH=/data/uploads
STORAGE_PROJECT_QUOTA_BYTES=1073741824
TRUSTED_PROXIES=
MCP_ALLOWED_ORIGINS=http://backlog.localhost:4173
PLATFORM_ADMIN_SUBJECTS=http://identity.localhost:8081/realms/backlog-killer|30000000-0000-4000-8000-000000000001
DEMO_PROJECT_KEY=demo-project

ONPREM_TENANT_NAME=Backlog Killer
ONPREM_PROJECT_NAME=Default Project
ONPREM_PROJECT_KEY=default-project
ONPREM_OWNER_SUBJECT=replace-with-oidc-subject
ONPREM_OWNER_EMAIL=owner@example.com
ONPREM_PROJECT_ORIGIN=https://app.example.com
